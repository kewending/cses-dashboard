generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id                     String    @id @default(cuid())
  title                  String
  status                 String    @default("today")
  tag                    String?
  priority               String?   // 'Low', 'Medium', 'High'
  
  startDate              DateTime?
  dueDate                DateTime?
  
  plannedDurationMinutes Int       @default(30)
  actualDurationSeconds  Int       @default(0)
  isCompleted            Boolean   @default(false)
  notes                  String?
  showInKanban           Boolean   @default(true)
  order                  Int       @default(0)
  
  parentTaskId           String?
  parentTask             Task?     @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks               Task[]    @relation("Subtasks")
  
  sessions               Session[]
  
  projectId              String?
  project                Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startMinutes Int      
  date         DateTime 
}

model Objective {
  id          String    @id @default(cuid())
  title       String
  description String?
  projects    Project[]
}

model Project {
  id              String      @id @default(cuid())
  title           String
  description     String?
  status          String      @default("BACKLOG")
  
  startDate       DateTime?
  endDate         DateTime?
  order           Int         @default(0)

  objectiveId     String?
  objective       Objective?  @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  
  parentProjectId String?
  parentProject   Project?    @relation("Subprojects", fields: [parentProjectId], references: [id], onDelete: Cascade)
  subprojects     Project[]   @relation("Subprojects")
  
  tasks           Task[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ─── CRM Module ───────────────────────────────────────────────────────────────

model Contact {
  id                 String   @id @default(cuid())
  avatarUrl          String?
  fullName           String
  chineseName        String?
  displayName        String?
  tier               Int      @default(3)    // 0=核心, 1=重要, 2=关注, 3=普通
  status             String   @default("active") // active | archived
  gender             String?                 // male | female | other | prefer_not_to_say
  birthday           String?                 // YYYY-MM-DD
  city               String?
  nation             String?                 // Country name
  occupation         String?                 // Job title / field
  relationshipStatus String?                 // single | married | in_relationship | divorced | widowed | prefer_not_to_say
  tags               String?                 // JSON array stored as string: ["education","work",...]
  notes              String?                 // Markdown text notes

  contactMethods    ContactMethod[]
  backgroundHistory BackgroundHistory[]
  interactions      Interaction[]
  relatedTo         ContactRelation[]  @relation("RelationFrom")
  relatedFrom       ContactRelation[]  @relation("RelationTo")
  dailyLogLinks     CRMInteractionLink[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMethod {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String  // email | phone | wechat | linkedin | twitter | github | scholar | other
  label     String? // 工作 | 私人 | etc.
  value     String
}

model BackgroundHistory {
  id           String  @id @default(cuid())
  contactId    String
  contact      Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  category     String  // work | education
  organization String
  titleOrMajor String?
  startDate    String? // YYYY or YYYY-MM
  endDate      String? // YYYY, YYYY-MM, or "present"
  description  String?
}

model Interaction {
  id           String   @id @default(cuid())
  contactId    String
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  date         String   // YYYY-MM-DD
  type         String?  // meeting | call | email | event | other
  summary      String
  sourceModule String   @default("manual") // manual | journal (future hook)
  createdAt    DateTime @default(now())
}

model ContactRelation {
  id     String  @id @default(cuid())
  fromId String
  toId   String
  label  String? // 同学 | 同事 | 前老板 | etc.
  from   Contact @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Contact @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

// ─── Finance Module ───────────────────────────────────────────────────────────

model FinanceAccount {
  id             String               @id @default(cuid())
  name           String
  type           String               // CHECKING | SAVINGS | INVESTMENT | CREDIT | LOAN | PHYSICAL_ASSET
  currency       String               // ISO 4217, e.g., AUD, USD, CNY
  initialBalance Float                @default(0)
  currentBalance Float                @default(0)
  isLiability    Boolean              @default(false)

  transactions   FinanceTransaction[] @relation("AccountTransactions")
  transfersIn    FinanceTransaction[] @relation("TransferDestination")

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model FinanceCategory {
  id           String               @id @default(cuid())
  name         String
  type         String               // EXPENSE | INCOME
  color        String?              // Hex code or tag token
  
  transactions FinanceTransaction[]

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model FinanceTransaction {
  id                   String           @id @default(cuid())
  
  accountId            String
  account              FinanceAccount   @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  
  date                 DateTime
  amount               Float            // Always positive
  type                 String           // INCOME | EXPENSE | TRANSFER
  exchangeRate         Float?           // Custom transfer ratio for cross-currency transfers
  
  destinationAccountId String?
  destinationAccount   FinanceAccount?  @relation("TransferDestination", fields: [destinationAccountId], references: [id])
  
  categoryId           String?
  category             FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  note                 String?

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model ExchangeRate {
  id             String   @id @default(cuid())
  sourceCurrency String
  targetCurrency String
  rate           Float
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([sourceCurrency, targetCurrency])
}

// ─── Second Brain Module ─────────────────────────────────────────────────────

model Note {
  id              String      @id @default(cuid())
  title           String
  content         String      // Unified content field (HTML/JSON from TipTap)
  layer           String      // "L1", "L2", "L3"
  status          String      @default("INCOMPLETE") // "INCOMPLETE" | "COMPLETED"
  paraCategory    String      @default("INBOX")      // PROJECT | AREA | RESOURCE | ARCHIVE | INBOX
  touchCount      Int         @default(0)
  lastTouchedAt   DateTime    @default(now())
  sourceUrl       String?     // original unprocessed source link (for L1)
  linkedProjectId String?     // ID for the L2 -> Project bindings

  linksOut        NoteLink[]  @relation("NoteLinkFrom")
  linksIn         NoteLink[]  @relation("NoteLinkTo")

  dailyLinks      DailyLogLink[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model NoteLink {
  id       String @id @default(cuid())
  fromId   String
  toId     String
  fromNote Note   @relation("NoteLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toNote   Note   @relation("NoteLinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

model DailyLog {
  id           String             @id @default(cuid())
  date         String             @unique // YYYY-MM-DD
  content      String             // The actual TipTap content (Execution/Distillation zones)
  weatherData  String?            // JSON string for Open-Meteo weather context
  
  linkedNotes  DailyLogLink[]
  crmLinks     CRMInteractionLink[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model DailyLogLink {
  id         String   @id @default(cuid())
  dailyLogId String
  noteId     String
  dailyLog   DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([dailyLogId, noteId])
}

model CRMInteractionLink {
  id         String   @id @default(cuid())
  dailyLogId String
  contactId  String
  dailyLog   DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([dailyLogId, contactId])
}

// ─── Health Module ────────────────────────────────────────────────────────────

model ActivityData {
  id               String   @id @default(cuid())
  date             String   @unique // YYYY-MM-DD
  
  steps            Int
  distanceKm       Float
  caloriesKcal     Float
  timelineJson     String   // Stored as JSON string due to SQLite limitations
}

model SleepData {
  id               String   @id @default(cuid())
  date             String   @unique // YYYY-MM-DD
  
  totalDurationMins Int
  deepSleepMins    Int
  lightSleepMins   Int
  remSleepMins     Int
  awakeTimes       Int?
  fallingSleepMins Int?
  sleepEfficiency  Int?
  startTime        String
  endTime          String
}

model HeartRateData {
  id               String   @id @default(cuid())
  date             String   // YYYY-MM-DD (not unique since multiple records per day)
  
  time             String   // e.g., "08:30AM"
  bpm              Int
}

model PhysicalData {
  id                 String   @id @default(cuid())
  date               String   @unique // YYYY-MM-DD
  
  weightKg           Float?
  bmi                Float?
  bodyFatPct         Float?
  fatMassKg          Float?
  fatFreeMassKg      Float?
  muscleMassKg       Float?
  muscleRatePct      Float?
  skeletalMusclePct  Float?
  boneMassKg         Float?
  proteinMassKg      Float?
  proteinPct         Float?
  waterWeightKg      Float?
  bodyWaterPct       Float?
  subcutaneousFatPct Float?
  visceralFat        Float?
  bmrKcal            Float?
  bodyAge            Int?
  idealBodyWeightKg  Float?
}

// ─── Health Module ────────────────────────────────────────────────────────────

// ─── Psychology & Emotion Module ──────────────────────────────────────────────

model MomentaryCheckIn {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  date         String   // YYYY-MM-DD for easy daily querying
  
  // Circumplex Model
  valence      Int      // -5 to +5
  arousal      Int      // -5 to +5
  
  // Subjective Metrics
  energyLevel  Int      // 1 to 10
  anxietyLevel Int      // 0 to 10
  
  // Subjective Sleep
  sleepHours   Float?
  sleepQuality Int?     // 1 to 5
  
  tags         String?  // JSON array string: ["study", "social"]
  notes        String?  // Qualitative trigger notes

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PeriodicAssessment {
  id               String   @id @default(cuid())
  timestamp        DateTime @default(now())
  date             String   // YYYY-MM-DD
  
  instrument       String   // "PHQ-9" | "GAD-7" | "WHO-5"
  itemScores       String   // JSON string of raw responses
  totalScore       Int
  severityLabel    String
  
  requiresCrisisIntervention Boolean @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
