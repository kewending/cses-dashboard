generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id                     String    @id @default(cuid())
  title                  String
  status                 String    @default("today")
  tag                    String?
  priority               String?   // 'Low', 'Medium', 'High'
  
  startDate              DateTime?
  dueDate                DateTime?
  
  plannedDurationMinutes Int       @default(30)
  actualDurationSeconds  Int       @default(0)
  isCompleted            Boolean   @default(false)
  notes                  String?
  showInKanban           Boolean   @default(true)
  order                  Int       @default(0)
  
  parentTaskId           String?
  parentTask             Task?     @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks               Task[]    @relation("Subtasks")
  
  sessions               Session[]
  
  projectId              String?
  project                Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startMinutes Int      
  date         DateTime 
}

model Objective {
  id          String    @id @default(cuid())
  title       String
  description String?
  projects    Project[]
}

model Project {
  id              String      @id @default(cuid())
  title           String
  description     String?
  status          String      @default("BACKLOG")
  
  startDate       DateTime?
  endDate         DateTime?
  order           Int         @default(0)

  objectiveId     String?
  objective       Objective?  @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  
  parentProjectId String?
  parentProject   Project?    @relation("Subprojects", fields: [parentProjectId], references: [id], onDelete: Cascade)
  subprojects     Project[]   @relation("Subprojects")
  
  tasks           Task[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
